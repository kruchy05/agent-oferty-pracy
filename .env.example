# Skopiuj ten plik jako .env i wpisz swoje wartości. Plik .env NIE trafia na GitHuba.
# Zmienne środowiskowe (np. ustawione przez setx) mają pierwszeństwo przed tym plikiem.

# klucz potrzebny tylko do uruchamiania z konsoli (python szukaj.py)
ANTHROPIC_API_KEY=sk-ant-wpisz-tutaj-swoj-klucz

# Opcjonalne - odkomentuj, żeby zmienić domyślne wartości
