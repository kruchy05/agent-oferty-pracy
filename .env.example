# Skopiuj ten plik jako .env i wpisz swoje wartości. Plik .env NIE trafia na GitHuba.
# Zmienne środowiskowe (np. ustawione przez setx) mają pierwszeństwo przed tym plikiem.

# mój klucz - do konsoli (python szukaj.py) i do API, gdy ktoś nie poda swojego (patrz API_KLUCZ_SERWERA)
ANTHROPIC_API_KEY=sk-ant-wpisz-tutaj-swoj-klucz

# baza Postgres (opcjonalnie). Bez tej linii wyniki trafiają tylko do plików .ods / .json.
# Znaki specjalne w haśle (@ : / # ?) trzeba zakodować, np. @ -> %40
# DATABASE_URL=postgresql://postgres:TWOJE_HASLO@localhost:5432/postgres

# Opcjonalne - odkomentuj, żeby zmienić domyślne wartości
# CLAUDE_MODEL=claude-haiku-5-5
# BUDZET_MAX_USD=1.0
# MIN_OFERT=10
# LICZBA_OFERT=20
# MAKS_WIEK_DNI=60
# MAX_RUND=3
# MAX_PROB_W_RUNDZIE=10
# MAX_WYSZUKIWAN=2
# MAX_POBRAN_W_RUNDZIE=6
# MAX_STRON_STARTOWYCH=4
# MAX_ZNAKOW_STRONY=12000
# WEB_SEARCH_DYNAMICZNE=auto

# API (uvicorn app.api:app)
# API_MAKS_SZUKAN=2
# False przed wystawieniem strony do internetu - inaczej obcy szukają na mój klucz
# API_KLUCZ_SERWERA=true
